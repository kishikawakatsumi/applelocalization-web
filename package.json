{
  "scripts": {
    "dev": "webpack --progress --config webpack.dev.js",
    "prod": "webpack --progress --config webpack.prod.js",
    "test": "node --test tests/*.test.mjs",
    "test:web": "deno test --node-modules-dir=none --frozen --allow-read --allow-write tests/validation-api.test.ts tests/context-index.test.ts tests/language-groups.test.ts tests/release-review.test.ts tests/release-web.test.ts tests/agent-access.test.ts",
    "test:browser": "npm run prod && ALLOW_SEARCH_HISTORY_TEST=1 node --test tests/search-history.browser.mjs",
    "data:collect": "node scripts/collect-release-batch.mjs",
    "data:sql": "node scripts/candidate-pipeline.mjs",
    "data:image": "node scripts/release-set-image.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "bulma": "1.0.4",
    "tabulator-tables": "6.6.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1"
  },
  "devDependencies": {
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "handlebars-loader": "1.7.3",
    "html-webpack-plugin": "5.6.8",
    "mini-css-extract-plugin": "2.10.2",
    "webpack": "5.111.1",
    "webpack-bundle-analyzer": "5.4.0",
    "webpack-cli": "7.2.3",
    "webpack-merge": "6.0.1"
  }
}
